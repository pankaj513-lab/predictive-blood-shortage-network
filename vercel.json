{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "builds": [
    { "src": "*.html", "use": "@vercel/static" },
    { "src": "styles.css", "use": "@vercel/static" },
    { "src": "src/**", "use": "@vercel/static" },
    { "src": "assets/**", "use": "@vercel/static" },
    { "src": "api/*.js", "use": "@vercel/node" }
  ],
  "routes": [
    {
      "src": "^/(.*)$",
      "headers": {
        "X-Content-Type-Options": "nosniff",
        "X-Frame-Options": "SAMEORIGIN",
        "Referrer-Policy": "strict-origin-when-cross-origin",
        "Permissions-Policy": "camera=(), microphone=(), geolocation=(self)"
      },
      "continue": true
    },
    {
      "src": "^/api/config$",
      "dest": "/api/config.js",
      "headers": { "Cache-Control": "no-store" }
    },
    { "src": "^/$", "dest": "/index.html" },
    { "src": "^/ai-prediction$", "dest": "/dashboard.html" },
    { "src": "^/donors$", "dest": "/requests-donors.html" },
    { "src": "^/contact$", "dest": "/about.html" },
    {
      "src": "^/(dashboard|network|requests-donors|reports|about|auth|user-dashboard|hospital-login|hospital-dashboard|admin-login|admin)$",
      "dest": "/$1.html"
    },
    { "handle": "filesystem" }
  ]
}
