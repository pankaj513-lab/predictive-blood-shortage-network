# Supabase Public Client Configuration (copy to .env and fill in your project values)
# NEVER put your Supabase service_role, database password, or Google OAuth Client Secret in frontend files!
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-publishable-or-anon-key

# Google OAuth 2.0 Setup (Configured in Supabase Dashboard -> Authentication -> Providers -> Google)
# 1. Google Cloud Console Authorized Redirect URI:
#    https://your-project-ref.supabase.co/auth/v1/callback
# 2. Supabase Auth Redirect URLs (Authentication -> URL Configuration):
#    http://localhost:5173/user-dashboard.html
#    http://localhost:5173/auth.html
